# Server
PORT=3000
NODE_ENV=development

# Database — PostgreSQL. `docker compose up -d` starts a local instance matching this URL.
DATABASE_URL=postgresql://dices_game:dices_game@localhost:5432/dices_game

# Auth — JWT_SECRET must be at least 32 bytes; required in every environment.
JWT_SECRET=change-me-to-a-random-32-byte-minimum-secret

# CORS + CSRF Origin allowlist. Required (and must not contain "localhost") when
# NODE_ENV=production — the server refuses to boot otherwise.
FRONTEND_URL=http://localhost:5173

# Dev/test only — seeds the dice roller for deterministic tests. Must be unset in
# production; the server refuses to boot if it is set there.
# DICE_SEED=42
