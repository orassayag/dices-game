// DB-level invariants (CHECK constraints, triggers, the partial unique index) are NOT
// expressible in Prisma's schema DSL — they live in a hand-written raw-SQL migration
// layered on top of the tables this file generates.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GameMode {
  human
  ai
}

enum GameStatus {
  in_progress
  finished
  abandoned
}

enum MoveKind {
  roll
  hold
  forfeit
}

model User {
  id                 String              @id @default(cuid())
  username           String
  usernameKey        String              @unique
  passwordHash       String
  tokenVersion       Int                 @default(0)
  createdAt          DateTime            @default(now())
  games              Game[]
  leaderboardPlayers LeaderboardPlayer[]
}

// One row per distinct player name within an owner's account (the AI is the fixed
// AI_PLAYER_NAME row). Wins accumulate across games by name, so the leaderboard survives
// a page refresh and grows as new names play. Scoped per owner via the composite unique key.
model LeaderboardPlayer {
  id          String   @id @default(cuid())
  ownerUserId String
  owner       User     @relation(fields: [ownerUserId], references: [id])
  name        String
  wins        Int      @default(0)
  createdAt   DateTime @default(now())

  @@unique([ownerUserId, name])
}

model Game {
  id          String     @id @default(cuid())
  ownerUserId String
  owner       User       @relation(fields: [ownerUserId], references: [id])
  mode        GameMode   @default(human)
  p1Name      String // display name credited on a seat-1 win; the AI name when the AI holds seat 1
  p2Name      String // display name credited on a seat-2 win; the AI name when the AI holds seat 2
  aiSeat      Int? // 1 | 2 when mode = ai; DB CHECK ties this to `mode`
  aiMoveCount Int        @default(0) // successful moves only; DB CHECK caps this at 50
  targetScore Int
  status      GameStatus @default(in_progress)
  currentSeat Int        @default(1)
  p1Score     Int        @default(0)
  p2Score     Int        @default(0)
  roundScore  Int        @default(0)
  lastDice    Int[]      @default([])
  winnerSeat  Int?
  version     Int        @default(0) // optimistic lock
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  moves       Move[]

  @@index([ownerUserId, status])
}

model Move {
  id         String   @id @default(cuid())
  gameId     String
  game       Game     @relation(fields: [gameId], references: [id])
  actorSeat  Int
  kind       MoveKind
  dice       Int[]    @default([])
  busted     Boolean  @default(false)
  roundScore Int // round score AFTER this move
  createdAt  DateTime @default(now())

  @@index([gameId])
}
